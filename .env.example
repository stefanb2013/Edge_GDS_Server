# Copy this file to .env and adjust values, or set these as real environment
# variables / docker-compose environment entries. Nothing here has a built-in
# default that would be unsafe in production.

# --- Networking -------------------------------------------------------------
# Hostname/IP other applications will use to reach this GDS. Used in the OPC UA
# discovery/endpoint URL and as a SAN entry on the server's own instance cert.
GDS_HOSTNAME=localhost
GDS_OPCUA_PORT=4840
GDS_HTTP_PORT=8443

# --- Data ---------------------------------------------------------------
GDS_DATA_DIR=/data

# --- Certificate Authority (root CA created on first boot) ------------------
GDS_CA_COMMON_NAME=My Organization GDS Root CA
GDS_CA_ORGANIZATION=My Organization
GDS_CA_COUNTRY=DE
GDS_CA_KEY_BITS=3072
GDS_CA_VALID_DAYS=7300
# Validity handed out to application-instance certificates issued by the CA
GDS_ISSUED_CERT_VALID_DAYS=730

# --- Web admin ----------------------------------------------------------
GDS_ADMIN_USER=admin
# If left unset, a random password is generated on first boot and printed
# once to the container logs.
GDS_ADMIN_PASSWORD=
# Random secret used to sign the web session cookie. If left unset, a random
# one is generated at startup (sessions won't survive a restart).
GDS_SESSION_SECRET=
