# Edge GDS Server configuration for the Windows Service build.
#
# The installer writes a real .env next to EdgeGDSServer.exe automatically
# on first install (with GDS_DATA_DIR already pointing at ProgramData) --
# this file is just the full reference; copy values you want to change into
# that real .env and restart the service (`net stop`/`net start
# EdgeGDSServer`) to pick them up. It's read by gds/config.py, so anything
# valid in the Docker deployment's .env.example works here too.

# --- Networking ---------------------------------------------------------
# Hostname/IP other applications will use to reach this GDS. Used in the OPC UA
# discovery/endpoint URL and as a SAN entry on the server's own instance and
# web UI TLS certificates.
GDS_HOSTNAME=localhost
GDS_OPCUA_PORT=4840
GDS_HTTP_PORT=8443

# --- Data -----------------------------------------------------------------
# Where the CA private key, issued-certificate database, and web session
# secret live -- treat it like a secrets store. Defaults to
# C:\ProgramData\Edge GDS Server\data, written here by the installer.
GDS_DATA_DIR=C:\ProgramData\Edge GDS Server\data

# --- Certificate Authority (root CA created on first start) ---------------
GDS_CA_COMMON_NAME=My Organization GDS Root CA
GDS_CA_ORGANIZATION=My Organization
GDS_CA_COUNTRY=DE
GDS_CA_KEY_BITS=3072
GDS_CA_VALID_DAYS=7300
# Validity handed out to application-instance certificates issued by the CA
GDS_ISSUED_CERT_VALID_DAYS=730

# --- Web admin --------------------------------------------------------------
GDS_ADMIN_USER=admin
# If left unset, a random password is generated on first start and printed
# once to edge-gds-server.log next to the .exe.
GDS_ADMIN_PASSWORD=
# Random secret used to sign the web session cookie. If left unset, a random
# one is generated at startup (sessions won't survive a service restart).
GDS_SESSION_SECRET=

# --- Push-mode auto re-provisioning ------------------------------------
# Also editable live from the web UI's Settings page (persisted there once
# changed, which then takes precedence over these on the next start).
GDS_PUSH_AUTO_REPROVISION=true
GDS_PUSH_HEALTH_CHECK_INTERVAL=300
